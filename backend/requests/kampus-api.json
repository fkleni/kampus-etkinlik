{
  "info": {
    "name": "Kampüs API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "eventId", "value": "" }
  ],
  "item": [
    {
      "name": "1 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "2 Etkinlik listesi",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const list = pm.response.json();",
              "if (Array.isArray(list) && list.length > 0) {",
              "  pm.collectionVariables.set('eventId', list[0]._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events"]
        }
      },
      "response": []
    },
    {
      "name": "3 Tek etkinlik",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/{{eventId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events", "{{eventId}}"]
        }
      },
      "response": []
    },
    {
      "name": "4 Olmayan etkinlik (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/yok",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events", "yok"]
        }
      },
      "response": []
    },
    {
      "name": "5 Etkinlik oluştur (201)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Git Workshop\",\n  \"category\": \"Workshop\",\n  \"date\": \"2026-12-01\",\n  \"time\": \"14:00\",\n  \"location\": \"Computer Lab 1\",\n  \"capacity\": 30,\n  \"description\": \"First steps with Git and GitHub.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events"]
        }
      },
      "response": []
    },
    {
      "name": "6 Eksik veri (400)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Only title\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events"]
        }
      },
      "response": []
    }
  ]
}